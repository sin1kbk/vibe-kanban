[Unit]
Description=Vibe Kanban Mobile Proxy
After=network.target vibe-kanban.service
Requires=vibe-kanban.service

[Service]
Type=simple
User=agent
Environment=PORT=58080
Environment=HOST=127.0.0.1
Environment=TARGET_ORIGIN=http://127.0.0.1:58081
Environment=PATH=/usr/local/bin:/usr/bin:/bin
WorkingDirectory={{REPO_ROOT}}/mobile-proxy
ExecStart=/usr/bin/env node proxy.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
